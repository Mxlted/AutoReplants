{
    "schemaVersion": 1,
    "id": "autoreplants",
    "version": "${version}",
    "name": "AutoReplants",
    "description": "Automatically replants crops when harvesting with a hoe",
    "icon": "assets/autoreplants/icon.png",
    "authors": [
        "AutoReplants Team"
    ],
    "contact": {},
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.autoreplants.AutoReplantsMod"
        ],
        "modmenu": ["com.autoreplants.config.ModMenuIntegration"]
    },
    "suggests": {
        "modmenu": "*",
        "cloth-config": "*"
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "${fabric_api_version_range}",
        "minecraft": "${minecraft_version_range}"
    }
}
